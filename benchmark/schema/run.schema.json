{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/emadhammami/responsible-agentic-workflows/benchmark/schema/run.schema.json",
  "title": "Responsible Agentic Workflows Benchmark Run",
  "description": "Schema for one raw execution record produced by B0, B1, or G1. Reference answers and benchmark evaluation scores are intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "experiment_id",
    "task_id",
    "condition",
    "started_at",
    "finished_at",
    "status",
    "code_revision",
    "configuration",
    "retrieval",
    "usage",
    "timing",
    "final_output",
    "events",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.2"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^T[0-9]{3,}$"
    },
    "condition": {
      "type": "string",
      "enum": [
        "B0",
        "B1",
        "G1"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "completed_after_recovery",
        "resource_stopped",
        "tool_error",
        "failed"
      ]
    },
    "code_revision": {
      "type": "string",
      "minLength": 7,
      "description": "Git commit SHA used for this execution."
    },
    "configuration": {
      "$ref": "#/$defs/configuration"
    },
    "retrieval": {
      "$ref": "#/$defs/retrieval"
    },
    "usage": {
      "$ref": "#/$defs/usage"
    },
    "timing": {
      "$ref": "#/$defs/timing"
    },
    "final_output": {
      "$ref": "#/$defs/finalOutput"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    }
  },
  "$defs": {
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_provider",
        "model_name",
        "temperature",
        "prompt_version",
        "retrieval_config_id"
      ],
      "properties": {
        "model_provider": {
          "type": "string",
          "minLength": 1
        },
        "model_name": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": ["string", "null"]
        },
        "temperature": {
          "type": ["number", "null"]
        },
        "max_output_tokens": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1
        },
        "retrieval_config_id": {
          "type": "string",
          "minLength": 1
        },
        "workflow_config_id": {
          "type": ["string", "null"]
        },
        "random_seed": {
          "type": ["integer", "null"]
        }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calls"
      ],
      "properties": {
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/retrievalCall"
          }
        }
      }
    },
    "retrievalCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "query",
        "top_k",
        "latency_ms",
        "retrieved_chunks"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "top_k": {
          "type": "integer",
          "minimum": 1
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "retrieved_chunks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/retrievedChunk"
          }
        }
      }
    },
    "retrievedChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "chunk_id",
        "rank"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^DOC[0-9]{3,}$"
        },
        "chunk_id": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "section": {
          "type": ["string", "null"]
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "retrieval_score": {
          "type": ["number", "null"]
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "llm_calls",
        "retrieval_calls",
        "tool_calls",
        "retries"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "llm_calls": {
          "type": "integer",
          "minimum": 0
        },
        "retrieval_calls": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "end_to_end_ms"
      ],
      "properties": {
        "end_to_end_ms": {
          "type": "number",
          "minimum": 0
        },
        "retrieval_ms": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "llm_ms": {
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },
    "finalOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer",
        "abstained"
      ],
      "properties": {
        "answer": {
          "type": ["string", "null"]
        },
        "abstained": {
          "type": "boolean"
        },
        "cited_chunk_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "event_type",
        "timestamp"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "event_type": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": ["string", "null"]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "details": {
          "type": ["object", "null"]
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error_type",
        "message"
      ],
      "properties": {
        "error_type": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": ["string", "null"]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": ["boolean", "null"]
        }
      }
    }
  }
}
