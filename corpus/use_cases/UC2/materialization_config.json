{
  "schema_version": "0.1",
  "config_id": "UC2-MIXED-SOURCE-UNIT-v0.1",
  "use_case_id": "UC2",
  "status": "frozen",
  "input_scope": {
    "membership_source": "corpus_membership.json",
    "accepted_documents_only": true,
    "accepted_count": 17,
    "excluded_document_ids": [
      "DOC054"
    ]
  },
  "source_unit_semantics": {
    "pdf": "one physical PDF page",
