    "page_unit": "physical_page"
  },
  "html_extraction": {
    "parser": "python_stdlib_html_parser",
    "encoding": "UTF-8",
    "encoding_errors": "strict",
    "preferred_content_root": "main",
    "fallback_content_root": "body_then_document",
    "excluded_elements": [
      "script",
      "style",
      "noscript",
      "svg",
      "template",
      "nav",
      "header",
      "footer",
      "form",
      "aside"
    ]
  },
  "text_normalization": {
    "unicode_normalization": "NFC",
    "replace_nbsp_with_space": true,
    "whitespace": "collapse_all_runs_to_single_ascii_space",
