  "controls": {
    "selection_based_on_content_length": false,
    "selection_based_on_retrieval_performance": false,
    "selection_based_on_benchmark_performance": false,
    "excluded_document_materialization_forbidden": true,
    "benchmark_started": false
  },
  "frozen": true
