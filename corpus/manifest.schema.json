{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Responsible Agentic Workflows Real Corpus Manifest",
  "description": "Manifest for real thesis use cases and source documents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "status",
    "use_cases",
    "documents"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "working",
        "frozen"
      ]
    },
    "use_cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/useCase"
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document"
      }
    }
  },
  "$defs": {
    "useCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "use_case_id",
        "name",
        "source_organization",
        "source_url",
        "status",
        "notes"
      ],
      "properties": {
        "use_case_id": {
          "type": "string",
          "pattern": "^UC[1-9][0-9]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source_organization": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "working",
            "frozen"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "use_case_id",
        "title",
        "source_organization",
        "source_reference",
        "source_url",
        "discovered_via",
        "publication_date",
        "language",
        "document_type",
        "rights_note",
        "local_raw_path",
        "local_processed_path",
        "sha256",
        "status",
        "exclusion_reason"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^DOC[0-9]{3,}$"
        },
        "use_case_id": {
          "type": "string",
          "pattern": "^UC[1-9][0-9]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source_organization": {
          "type": "string",
          "minLength": 1
        },
        "source_reference": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "discovered_via": {
          "type": [
            "string",
            "null"
          ]
        },
        "publication_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "document_type": {
          "type": "string",
          "minLength": 1
        },
        "rights_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "local_raw_path": {
          "type": "string",
          "minLength": 1
        },
        "local_processed_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "candidate",
            "accepted",
            "excluded"
          ]
        },
        "exclusion_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
