{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Corpus Batch Intake Queue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "use_case_id",
    "documents"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "use_case_id": {
      "type": "string",
      "pattern": "^UC[1-9][0-9]*$"
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document"
      }
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_file",
        "title",
        "source_organization",
        "source_reference",
        "source_url",
        "discovered_via",
        "publication_date",
        "language",
        "document_type",
        "rights_note"
      ],
      "properties": {
        "source_file": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source_organization": {
          "type": "string",
          "minLength": 1
        },
        "source_reference": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "discovered_via": {
          "type": [
            "string",
            "null"
          ]
        },
        "publication_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "document_type": {
          "type": "string",
          "minLength": 1
        },
        "rights_note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
